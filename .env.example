# 使用专用数据库和账号；parseTime 会由程序强制开启。禁止提交真实凭据。
MYSQL_DSN=work_schedule:change-me@tcp(mysql.example.com:3306)/work_schedule?charset=utf8mb4&parseTime=true&loc=UTC&tls=true
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:8080
WEB_DIR=web/dist
# 仅空数据库首次启动使用；密码至少 12 字符。创建后可从环境中移除。
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=
# 线上 HTTPS 部署必须 true；本地 HTTP 测试设为 false。
COOKIE_SECURE=false
